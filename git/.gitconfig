[user]
	name = Gustavo Pacheco
	email = ryctabo@gmail.com
	signingkey = 276EE881B315AF7E

[alias]
	lod = log --oneline --decorate
	undo = restore
	unstage = restore --staged
	last = log -1 HEAD
	co = checkout
	br = branch
	ci = commit
	st = status
	graph = log --oneline --decorate --graph

[core]
	editor = vim
	autocrlf = input

[pull]
	rebase = false

[init]
	defaultbranch = main

[commit]
	gpgsign = true

[includeIf "gitdir:~/Justo/**"]
	path = ~/Justo/.gitconfig

