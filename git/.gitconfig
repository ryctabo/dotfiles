[include]
		path = ~/.dotfiles/git/.gitconfig.local

[alias]
	lod = log --oneline --decorate
	undo = restore
	unstage = restore --staged
	last = log -1 HEAD
	co = checkout
	br = branch
	ci = commit
	st = status
	graph = log --oneline --decorate --graph

[core]
	editor = vim
	autocrlf = input

[pull]
	rebase = false

[init]
	defaultbranch = main

